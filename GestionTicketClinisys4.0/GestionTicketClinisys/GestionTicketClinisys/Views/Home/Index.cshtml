@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="@Url.Content("~/css/login.css")" />

<div class="login-container">
    <div class="login-header">
        <h1 class="Clinisys-Title">
            <span class="blue-section">Clini</span><span class="red-section">Sys</span>
        </h1>
        <!-- Future: Language button -->
        <!-- <button class="Lang-button"></button> -->
    </div>

    @if (TempData["LoginError"] != null)
    {
        <div class="login-error" style="color: red; text-align: center; margin-bottom: 10px;">
            @TempData["LoginError"]
        </div>
    }

    <!-- Body -->
    <div class="login-body">
        <img src="@Url.Content("~/login-logo.jpg")" alt="Logo" class="Login-logo" />

        <form asp-action="Login" asp-controller="Home" method="post" class="info-section">
            <div class="username-input">
                <input type="text" name="username" placeholder="UserName" required />
                <span>|</span>
                <span class="login-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 10a4 4 0 100-8 4 4 0 000 8zm0 2c-4.418 0-8 1.79-8 4v2h16v-2c0-2.21-3.582-4-8-4z" /></svg>
                </span>
            </div>
            <div class="password-input">
                <input type="password" name="password" placeholder="Password" required />
                <span>|</span>
                <span class="login-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M5 8V6a5 5 0 1110 0v2h1a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2v-8a2 2 0 012-2h1zm2-2a3 3 0 116 0v2H7V6zm-3 4v8h12v-8H4z" /></svg>
                </span>
            </div>
            <div class="login-footer">
                <button type="submit">Connect</button>
            </div>
        </form>
    </div>
</div>
