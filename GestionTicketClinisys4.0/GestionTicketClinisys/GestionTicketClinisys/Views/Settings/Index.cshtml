@{
    ViewData["Title"] = "Parametrage";
}

<link rel="stylesheet" href="@Url.Content("~/css/Settings.css")" />

<div class="container">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="page-title">PARAMETRAGE</div>
            <div class="breadcrumb">
                <a href="@Url.Action("Menu", "Home")">← Retour au Menu</a>
                <span>•</span>
                <span>Parametrage</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success" onclick="seedAllData()">
                🌱 Générer Données Test
            </button>
            <button class="btn btn-danger" onclick="clearAllData()">
                🗑️ Vider Base de Données
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="nav-tabs">
        <button class="nav-tab active" onclick="switchTab('users')">
            👥 Utilisateurs
        </button>
        <button class="nav-tab" onclick="switchTab('teams')">
            🏢 Équipes
        </button>
        <button class="nav-tab" onclick="switchTab('clients')">
            🏥 Clients
        </button>
        <button class="nav-tab" onclick="switchTab('modules')">
            🔧 Modules
        </button>
    </div>

    <!-- Users Tab Content -->
    <div id="users-tab" class="content-wrapper">
        <div class="content-header">
            <div class="content-title">Gestion des Utilisateurs</div>
            <div class="content-actions">
                <button class="btn btn-success" onclick="openCreateUserModal()">
                    ➕ Nouvel Utilisateur
                </button>
            </div>
        </div>
        <div class="content-body">
            <div class="toolbar">
                <div class="toolbar-left">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" class="search-input" placeholder="Rechercher un utilisateur..." id="userSearch">
                    </div>
                    <button class="btn btn-info btn-sm" onclick="clearUserFilters()">
                        🗑️ Effacer Filtres
                    </button>
                </div>
                <div class="toolbar-right">
                    <div class="filter-group">
                        <span class="filter-label">Rôle:</span>
                        <select class="form-control" id="roleFilter" style="width: auto;">
                            <option value="">Tous</option>
                            <option value="Administrator">Administrator</option>
                            <option value="Manager">Manager</option>
                            <option value="Technician">Technician</option>
                            <option value="User">User</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <span class="filter-label">Statut:</span>
                        <select class="form-control" id="statusFilter" style="width: auto;">
                            <option value="">Tous</option>
                            <option value="true">Actif</option>
                            <option value="false">Inactif</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <span id="userFilterCount" class="text-muted" style="font-size: 12px;"></span>
                    </div>
                </div>
            </div>

            <div class="table-container">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nom d'utilisateur</th>
                            <th>Nom complet</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th>Département</th>
                            <th>Équipe</th>
                            <th>Statut</th>
                            <th>Dernière connexion</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <tr>
                            <td colspan="9" class="text-center">
                                <div class="loading"></div>
                                Chargement des utilisateurs...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Teams Tab Content -->
    <div id="teams-tab" class="content-wrapper d-none">
        <div class="content-header">
            <div class="content-title">Gestion des Équipes</div>
            <div class="content-actions">
                <button class="btn btn-success" onclick="openCreateTeamModal()">
                    ➕ Nouvelle Équipe
                </button>
            </div>
        </div>
        <div class="content-body">
            <div class="toolbar">
                <div class="toolbar-left">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" class="search-input" placeholder="Rechercher une équipe..." id="teamSearch">
                    </div>
                    <button class="btn btn-info btn-sm" onclick="clearTeamFilters()">
                        🗑️ Effacer Filtres
                    </button>
                </div>
                <div class="toolbar-right">
                    <span id="teamFilterCount" class="text-muted" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="table-container">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nom de l'équipe</th>
                            <th>Nombre d'utilisateurs</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="teamsTableBody">
                        <tr>
                            <td colspan="3" class="text-center">
                                <div class="loading"></div>
                                Chargement des équipes...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Clients Tab Content -->
    <div id="clients-tab" class="content-wrapper d-none">
        <div class="content-header">
            <div class="content-title">Gestion des Clients</div>
            <div class="content-actions">
                <button class="btn btn-success" onclick="openCreateClientModal()">
                    ➕ Nouveau Client
                </button>
            </div>
        </div>
        <div class="content-body">
            <div class="toolbar">
                <div class="toolbar-left">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" class="search-input" placeholder="Rechercher un client..." id="clientSearch">
                    </div>
                    <button class="btn btn-info btn-sm" onclick="clearClientFilters()">
                        🗑️ Effacer Filtres
                    </button>
                </div>
                <div class="toolbar-right">
                    <span id="clientFilterCount" class="text-muted" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="table-container">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nom du client</th>
                            <th>Email</th>
                            <th>Nombre de tickets</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="clientsTableBody">
                        <tr>
                            <td colspan="4" class="text-center">
                                <div class="loading"></div>
                                Chargement des clients...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modules Tab Content -->
    <div id="modules-tab" class="content-wrapper d-none">
        <div class="content-header">
            <div class="content-title">Gestion des Modules</div>
            <div class="content-actions">
                <button class="btn btn-success" onclick="openCreateModuleModal()">
                    ➕ Nouveau Module
                </button>
            </div>
        </div>
        <div class="content-body">
            <div class="toolbar">
                <div class="toolbar-left">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" class="search-input" placeholder="Rechercher un module..." id="moduleSearch">
                    </div>
                    <button class="btn btn-info btn-sm" onclick="clearModuleFilters()">
                        🗑️ Effacer Filtres
                    </button>
                </div>
                <div class="toolbar-right">
                    <span id="moduleFilterCount" class="text-muted" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="table-container">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nom du module</th>
                            <th>Nombre de tickets</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="modulesTableBody">
                        <tr>
                            <td colspan="3" class="text-center">
                                <div class="loading"></div>
                                Chargement des modules...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- User Modal -->
<div id="userModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 99999;">
    <div id="userModalContent" style="background: white; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; position: relative; z-index: 100000; margin: 20px; padding: 0;">
        <div style="background-color: #2c5282; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0; font-size: 16px; font-weight: bold; position: relative;">
            <span id="userModalTitle">Nouvel Utilisateur</span>
            <button onclick="closeUserModal()" style="position: absolute; top: 10px; right: 15px; background: none; border: none; color: white; font-size: 20px; cursor: pointer; width: 30px; height: 30px;">×</button>
        </div>
        <div style="padding: 20px;">
            <form id="userForm">
                <input type="hidden" id="userId" name="id">
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nom d'utilisateur *</label>
                        <input type="text" class="form-control" id="userName" name="userName" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="userEmail" name="email" required>
                    </div>
                </div>

                <div class="form-group" id="passwordGroup">
                    <label class="form-label">Mot de passe *</label>
                    <input type="password" class="form-control" id="userPassword" name="password">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" id="userFirstName" name="firstName">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" id="userLastName" name="lastName">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Rôle</label>
                        <select class="form-control form-select" id="userRole" name="role">
                            <option value="User">User</option>
                            <option value="Technician">Technician</option>
                            <option value="Manager">Manager</option>
                            <option value="Administrator">Administrator</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Département</label>
                        <select class="form-control form-select" id="userDepartment" name="department">
                            <option value="">Sélectionner...</option>
                            <option value="IT">IT</option>
                            <option value="Support">Support</option>
                            <option value="Administration">Administration</option>
                            <option value="Formation">Formation</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Sécurité">Sécurité</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Poste</label>
                        <input type="text" class="form-control" id="userPosition" name="position">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" class="form-control" id="userPhone" name="phone">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Équipe</label>
                        <select class="form-control form-select" id="userTeam" name="teamId">
                            <option value="0">Aucune équipe</option>
                        </select>
                    </div>
                    <div class="form-group" id="statusGroup" style="display: none;">
                        <label class="form-label">Statut</label>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="userIsActive" name="isActive">
                            <label class="form-check-label" for="userIsActive">Utilisateur actif</label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn btn-secondary" onclick="closeUserModal()">Annuler</button>
            <button type="button" class="btn btn-primary" onclick="saveUser()">Enregistrer</button>
        </div>
    </div>
</div>

<!-- Team Modal -->
