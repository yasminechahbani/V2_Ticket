    <div id="teamModalContent" style="background: white; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; position: relative; z-index: 100000; margin: 20px; padding: 0;">
        <div style="background-color: #2c5282; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0; font-size: 16px; font-weight: bold; position: relative;">
