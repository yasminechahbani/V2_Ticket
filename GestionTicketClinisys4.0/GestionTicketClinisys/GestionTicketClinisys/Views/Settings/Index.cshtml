    // Search and filter setup
    function setupSearchFilters() {
        // User search - real-time
        document.getElementById('userSearch').addEventListener('input', function() {
            filterUsers();
        });

        // Role filter
        document.getElementById('roleFilter').addEventListener('change', function() {
            filterUsers();
        });

        // Status filter
        document.getElementById('statusFilter').addEventListener('change', function() {
            filterUsers();
        });

        // Team search - real-time
        document.getElementById('teamSearch').addEventListener('input', function() {
            filterTeams();
        });

        // Client search - real-time
        document.getElementById('clientSearch').addEventListener('input', function() {
            filterClients();
        });

        // Module search - real-time
        document.getElementById('moduleSearch').addEventListener('input', function() {
            filterModules();
        });
    }

    // Filter functions
    function filterUsers() {
        const searchTerm = document.getElementById('userSearch').value.toLowerCase();
        const roleFilter = document.getElementById('roleFilter').value;
        const statusFilter = document.getElementById('statusFilter').value;

        const filteredUsers = users.filter(user => {
            // Search in multiple fields
            const searchMatch = !searchTerm ||
                (user.userName && user.userName.toLowerCase().includes(searchTerm)) ||
                (user.email && user.email.toLowerCase().includes(searchTerm)) ||
                (user.firstName && user.firstName.toLowerCase().includes(searchTerm)) ||
                (user.lastName && user.lastName.toLowerCase().includes(searchTerm)) ||
                (user.department && user.department.toLowerCase().includes(searchTerm)) ||
                (user.position && user.position.toLowerCase().includes(searchTerm));

            // Role filter
            const roleMatch = !roleFilter || user.role === roleFilter;

            // Status filter
            const statusMatch = !statusFilter || user.isActive.toString() === statusFilter;

            return searchMatch && roleMatch && statusMatch;
        });

        // Use highlighting for users
        if (searchTerm) {
            renderUsersTableWithHighlight(filteredUsers, searchTerm);
        } else {
            renderUsersTable(filteredUsers);
        }
        updateFilterCounts();
    }

    function filterTeams() {
        const searchTerm = document.getElementById('teamSearch').value.toLowerCase();

        const filteredTeams = teams.filter(team => {
            return !searchTerm || team.name.toLowerCase().includes(searchTerm);
        });

        // Use highlighting for teams
        if (searchTerm) {
            renderTeamsTableWithHighlight(filteredTeams, searchTerm);
        } else {
            renderTeamsTable(filteredTeams);
        }
        updateFilterCounts();
    }

    function filterClients() {
        const searchTerm = document.getElementById('clientSearch').value.toLowerCase();

        const filteredClients = clients.filter(client => {
            return !searchTerm ||
                client.name.toLowerCase().includes(searchTerm) ||
                client.email.toLowerCase().includes(searchTerm);
        });

        // Use highlighting for clients
        if (searchTerm) {
            renderClientsTableWithHighlight(filteredClients, searchTerm);
        } else {
            renderClientsTable(filteredClients);
        }
        updateFilterCounts();
    }

    function filterModules() {
        const searchTerm = document.getElementById('moduleSearch').value.toLowerCase();

        const filteredModules = modules.filter(module => {
            return !searchTerm || module.name.toLowerCase().includes(searchTerm);
        });

        // Use highlighting for modules
        if (searchTerm) {
            renderModulesTableWithHighlight(filteredModules, searchTerm);
        } else {
            renderModulesTable(filteredModules);
        }
        updateFilterCounts();
    }

