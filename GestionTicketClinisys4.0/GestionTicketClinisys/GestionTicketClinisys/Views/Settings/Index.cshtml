    function renderModulesTableWithHighlight(dataToRender, searchTerm = '') {
        const tbody = document.getElementById('modulesTableBody');
        const modulesToRender = dataToRender || modules;

        if (modulesToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center">Aucun module trouvé</td></tr>';
            return;
        }

        tbody.innerHTML = modulesToRender.map(module => `
            <tr>
                <td>${highlightText(module.name, searchTerm)}</td>
                <td>${module.ticketCount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editModule(${module.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteModule(${module.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    // Data seeding functions
    async function seedAllData() {
        if (!confirm('Cela va créer des données de test (utilisateurs, clients, équipes, modules, tickets). Continuer ?')) {
            return;
        }

        try {
            const response = await fetch('/Home/SeedAllData');
            const result = await response.json();

            if (result.success) {
                showSuccess(result.message);
                // Refresh all data
                loadUsers();
                loadTeams();
                loadClients();
                loadModules();
            } else {
                showError(result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    async function clearAllData() {
        if (!confirm('ATTENTION: Cela va supprimer TOUTES les données de la base. Cette action est irréversible. Continuer ?')) {
            return;
        }

        try {
            const response = await fetch('/Home/ClearAllData');
            const result = await response.json();

            if (result.success) {
                showSuccess(result.message);
                // Clear all tables
                users = [];
                teams = [];
                clients = [];
                modules = [];
                renderUsersTable();
                renderTeamsTable();
                renderClientsTable();
                renderModulesTable();
            } else {
                showError(result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    // Close modals when clicking outside (like in Gestion Demandes)
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('userModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeUserModal();
            }
        });

        document.getElementById('teamModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeTeamModal();
            }
        });

        document.getElementById('clientModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeClientModal();
            }
        });

        document.getElementById('moduleModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModuleModal();
            }
        });

        // Handle ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeUserModal();
                closeTeamModal();
                closeClientModal();
                closeModuleModal();
            }
        });
    });
</script>
