<!-- Module Modal -->
<div id="moduleModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 99999;">
    <div id="moduleModalContent" style="background: white; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; position: relative; z-index: 100000; margin: 20px; padding: 0;">
        <div style="background-color: #2c5282; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0; font-size: 16px; font-weight: bold; position: relative;">
            <span id="moduleModalTitle">Nouveau Module</span>
            <button onclick="closeModuleModal()" style="position: absolute; top: 10px; right: 15px; background: none; border: none; color: white; font-size: 20px; cursor: pointer; width: 30px; height: 30px;">×</button>
        </div>
        <div style="padding: 20px;">
            <form id="moduleForm">
                <input type="hidden" id="moduleId" name="id">
                <div class="form-group">
                    <label class="form-label">Nom du module *</label>
                    <input type="text" class="form-control" id="moduleName" name="name" required>
                </div>
            </form>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn btn-secondary" onclick="closeModuleModal()">Annuler</button>
            <button type="button" class="btn btn-primary" onclick="saveModule()">Enregistrer</button>
        </div>
    </div>
</div>

<script>
    // Global variables
    let currentTab = 'users';
    let users = [];
    let teams = [];
    let clients = [];
    let modules = [];
    let isEditMode = false;

    // Initialize page
    document.addEventListener('DOMContentLoaded', function() {
        loadUsers();
        loadTeams();
        setupSearchFilters();
    });

    // Tab switching
    function switchTab(tabName) {
        // Hide all tabs
        document.querySelectorAll('.content-wrapper').forEach(tab => {
            tab.classList.add('d-none');
        });

        // Remove active class from all nav tabs
        document.querySelectorAll('.nav-tab').forEach(tab => {
            tab.classList.remove('active');
        });

        // Show selected tab
        document.getElementById(tabName + '-tab').classList.remove('d-none');

        // Add active class to selected nav tab
        event.target.classList.add('active');

        currentTab = tabName;

        // Load data for the selected tab
        switch(tabName) {
            case 'users':
                if (users.length === 0) loadUsers();
                break;
            case 'teams':
                if (teams.length === 0) loadTeams();
                break;
            case 'clients':
                if (clients.length === 0) loadClients();
                break;
            case 'modules':
                if (modules.length === 0) loadModules();
                break;
        }
    }

    // Load data functions
    async function loadUsers() {
        try {
            const response = await fetch('/Settings/GetUsers');
            const result = await response.json();

            if (result.success) {
                users = result.data;
                renderUsersTable();
                loadTeamsForDropdown();
                updateFilterCounts();
            } else {
                showError('Erreur lors du chargement des utilisateurs: ' + result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    async function loadTeams() {
        try {
            const response = await fetch('/Settings/GetTeams');
            const result = await response.json();

            if (result.success) {
                teams = result.data;
                renderTeamsTable();
                updateFilterCounts();
            } else {
                showError('Erreur lors du chargement des équipes: ' + result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    async function loadClients() {
        try {
            const response = await fetch('/Settings/GetClients');
            const result = await response.json();

            if (result.success) {
                clients = result.data;
                renderClientsTable();
                updateFilterCounts();
            } else {
                showError('Erreur lors du chargement des clients: ' + result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    async function loadModules() {
        try {
            const response = await fetch('/Settings/GetModules');
            const result = await response.json();

            if (result.success) {
                modules = result.data;
                renderModulesTable();
                updateFilterCounts();
            } else {
                showError('Erreur lors du chargement des modules: ' + result.message);
            }
        } catch (error) {
            showError('Erreur de connexion: ' + error.message);
        }
    }

    // Render table functions
    function renderUsersTable(dataToRender = null) {
        const tbody = document.getElementById('usersTableBody');
        const usersToRender = dataToRender || users;

        if (usersToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center">Aucun utilisateur trouvé</td></tr>';
            return;
        }

        tbody.innerHTML = usersToRender.map(user => `
            <tr>
                <td>${user.userName}</td>
                <td>${(user.firstName || '') + ' ' + (user.lastName || '')}</td>
                <td>${user.email || ''}</td>
                <td><span class="badge badge-info">${user.role || 'User'}</span></td>
                <td>${user.department || '-'}</td>
                <td>${user.teamName || '-'}</td>
                <td>
                    <span class="badge ${user.isActive ? 'badge-success' : 'badge-danger'}">
                        ${user.isActive ? 'Actif' : 'Inactif'}
                    </span>
                </td>
                <td>${user.lastLogin ? new Date(user.lastLogin).toLocaleDateString('fr-FR') : 'Jamais'}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editUser(${user.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteUser(${user.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    function renderTeamsTable(dataToRender = null) {
        const tbody = document.getElementById('teamsTableBody');
        const teamsToRender = dataToRender || teams;

        if (teamsToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center">Aucune équipe trouvée</td></tr>';
            return;
        }

        tbody.innerHTML = teamsToRender.map(team => `
            <tr>
                <td>${team.name}</td>
                <td>${team.userCount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editTeam(${team.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteTeam(${team.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    function renderClientsTable(dataToRender = null) {
        const tbody = document.getElementById('clientsTableBody');
        const clientsToRender = dataToRender || clients;

        if (clientsToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center">Aucun client trouvé</td></tr>';
            return;
        }

        tbody.innerHTML = clientsToRender.map(client => `
            <tr>
                <td>${client.name}</td>
                <td>${client.email}</td>
                <td>${client.ticketCount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editClient(${client.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteClient(${client.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    function renderModulesTable(dataToRender = null) {
        const tbody = document.getElementById('modulesTableBody');
        const modulesToRender = dataToRender || modules;

        if (modulesToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center">Aucun module trouvé</td></tr>';
            return;
        }

        tbody.innerHTML = modulesToRender.map(module => `
            <tr>
                <td>${module.name}</td>
                <td>${module.ticketCount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editModule(${module.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteModule(${module.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    // User Modal Functions
