    // Update filter counts
    function updateFilterCounts() {
        // Users count
        const userSearchTerm = document.getElementById('userSearch').value.toLowerCase();
        const roleFilter = document.getElementById('roleFilter').value;
        const statusFilter = document.getElementById('statusFilter').value;

        const filteredUsersCount = users.filter(user => {
            const searchMatch = !userSearchTerm ||
                (user.userName && user.userName.toLowerCase().includes(userSearchTerm)) ||
                (user.email && user.email.toLowerCase().includes(userSearchTerm)) ||
                (user.firstName && user.firstName.toLowerCase().includes(userSearchTerm)) ||
                (user.lastName && user.lastName.toLowerCase().includes(userSearchTerm)) ||
                (user.department && user.department.toLowerCase().includes(userSearchTerm)) ||
                (user.position && user.position.toLowerCase().includes(userSearchTerm));
            const roleMatch = !roleFilter || user.role === roleFilter;
            const statusMatch = !statusFilter || user.isActive.toString() === statusFilter;
            return searchMatch && roleMatch && statusMatch;
        }).length;

        document.getElementById('userFilterCount').textContent =
            `${filteredUsersCount} sur ${users.length} utilisateurs`;

        // Teams count
        const teamSearchTerm = document.getElementById('teamSearch').value.toLowerCase();
        const filteredTeamsCount = teams.filter(team =>
            !teamSearchTerm || team.name.toLowerCase().includes(teamSearchTerm)
        ).length;
        document.getElementById('teamFilterCount').textContent =
            `${filteredTeamsCount} sur ${teams.length} équipes`;

        // Clients count
        const clientSearchTerm = document.getElementById('clientSearch').value.toLowerCase();
        const filteredClientsCount = clients.filter(client =>
            !clientSearchTerm ||
            client.name.toLowerCase().includes(clientSearchTerm) ||
            client.email.toLowerCase().includes(clientSearchTerm)
        ).length;
        document.getElementById('clientFilterCount').textContent =
            `${filteredClientsCount} sur ${clients.length} clients`;

        // Modules count
        const moduleSearchTerm = document.getElementById('moduleSearch').value.toLowerCase();
        const filteredModulesCount = modules.filter(module =>
            !moduleSearchTerm || module.name.toLowerCase().includes(moduleSearchTerm)
        ).length;
        document.getElementById('moduleFilterCount').textContent =
            `${filteredModulesCount} sur ${modules.length} modules`;
    }

    // Highlight search terms
    function highlightText(text, searchTerm) {
        if (!searchTerm || !text) return text;

        const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        return text.replace(regex, '<mark style="background-color: #ffeb3b; padding: 1px 2px;">$1</mark>');
    }

    // Enhanced render functions with highlighting
    function renderUsersTableWithHighlight(dataToRender, searchTerm = '') {
        const tbody = document.getElementById('usersTableBody');
        const usersToRender = dataToRender || users;

        if (usersToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center">Aucun utilisateur trouvé</td></tr>';
            return;
        }

        tbody.innerHTML = usersToRender.map(user => `
            <tr>
                <td>${highlightText(user.userName, searchTerm)}</td>
                <td>${highlightText((user.firstName || '') + ' ' + (user.lastName || ''), searchTerm)}</td>
                <td>${highlightText(user.email || '', searchTerm)}</td>
                <td><span class="badge badge-info">${user.role || 'User'}</span></td>
                <td>${highlightText(user.department || '-', searchTerm)}</td>
                <td>${user.teamName || '-'}</td>
                <td>
                    <span class="badge ${user.isActive ? 'badge-success' : 'badge-danger'}">
                        ${user.isActive ? 'Actif' : 'Inactif'}
                    </span>
                </td>
                <td>${user.lastLogin ? new Date(user.lastLogin).toLocaleDateString('fr-FR') : 'Jamais'}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editUser(${user.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteUser(${user.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    function renderTeamsTableWithHighlight(dataToRender, searchTerm = '') {
        const tbody = document.getElementById('teamsTableBody');
        const teamsToRender = dataToRender || teams;

        if (teamsToRender.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center">Aucune équipe trouvée</td></tr>';
            return;
        }

        tbody.innerHTML = teamsToRender.map(team => `
            <tr>
                <td>${highlightText(team.name, searchTerm)}</td>
                <td>${team.userCount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="editTeam(${team.id})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteTeam(${team.id})">🗑️</button>
                </td>
            </tr>
        `).join('');
    }

    function renderClientsTableWithHighlight(dataToRender, searchTerm = '') {
