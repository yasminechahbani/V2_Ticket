// Clear all containers
function clearAll() {
    debugLog('🧹 Clearing all containers...');

    const containers = ['todo-container', 'progress-container', 'completed-container', 'cancelled-container'];

    containers.forEach(id => {
        const container = document.getElementById(id);
        if (container) {
