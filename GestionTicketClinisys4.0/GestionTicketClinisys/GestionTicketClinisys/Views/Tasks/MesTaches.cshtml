// Global variable to store current tasks data
let currentTasksData = null;

// Show Kanban view
function showKanban() {
    debugLog('🔄 showKanban() called');

    const kanbanEl = document.getElementById('simple-kanban');
    const tableEl = document.getElementById('table-view');
    const ganttEl = document.getElementById('gantt-view');

    debugLog(`Elements found: kanban=${!!kanbanEl}, table=${!!tableEl}, gantt=${!!ganttEl}`);

    if (kanbanEl) kanbanEl.style.display = 'grid';
    if (tableEl) tableEl.style.display = 'none';
    if (ganttEl) ganttEl.style.display = 'none';

    // Update button states
    const kanbanBtn = document.getElementById('kanbanBtn');
    const tableBtn = document.getElementById('tableBtn');
    const ganttBtn = document.getElementById('ganttBtn');

    if (kanbanBtn) kanbanBtn.classList.add('active');
    if (tableBtn) tableBtn.classList.remove('active');
    if (ganttBtn) ganttBtn.classList.remove('active');

    debugLog('📋 Switched to Kanban view');
}

// Show Table view
function showTable() {
    debugLog('🔄 showTable() called');

    const kanbanEl = document.getElementById('simple-kanban');
    const tableEl = document.getElementById('table-view');
    const ganttEl = document.getElementById('gantt-view');

    debugLog(`Elements found: kanban=${!!kanbanEl}, table=${!!tableEl}, gantt=${!!ganttEl}`);

    if (kanbanEl) kanbanEl.style.display = 'none';
    if (tableEl) tableEl.style.display = 'block';
    if (ganttEl) ganttEl.style.display = 'none';

    // Update button states
    const kanbanBtn = document.getElementById('kanbanBtn');
    const tableBtn = document.getElementById('tableBtn');
    const ganttBtn = document.getElementById('ganttBtn');

    if (kanbanBtn) kanbanBtn.classList.remove('active');
    if (tableBtn) tableBtn.classList.add('active');
    if (ganttBtn) ganttBtn.classList.remove('active');

    debugLog('📊 Switched to Table view');
    loadTableData();
}

// Show Gantt view
function showGantt() {
    debugLog('🔄 showGantt() called');

    const kanbanEl = document.getElementById('simple-kanban');
    const tableEl = document.getElementById('table-view');
    const ganttEl = document.getElementById('gantt-view');

    debugLog(`Elements found: kanban=${!!kanbanEl}, table=${!!tableEl}, gantt=${!!ganttEl}`);

    if (kanbanEl) kanbanEl.style.display = 'none';
    if (tableEl) tableEl.style.display = 'none';
    if (ganttEl) ganttEl.style.display = 'block';

    // Update button states
    const kanbanBtn = document.getElementById('kanbanBtn');
    const tableBtn = document.getElementById('tableBtn');
    const ganttBtn = document.getElementById('ganttBtn');

    if (kanbanBtn) kanbanBtn.classList.remove('active');
    if (tableBtn) tableBtn.classList.remove('active');
    if (ganttBtn) ganttBtn.classList.add('active');

    debugLog('📈 Switched to Gantt view');
    loadGanttData();
}

// Load data for table view
async function loadTableData() {
    debugLog('📊 Loading table data...');

    try {
        const response = await fetch('/Tasks/GetKanbanData');
        const result = await response.json();

        if (result.success) {
            currentTasksData = result.data;
            renderTableData();
        } else {
            debugLog(`❌ Table API Error: ${result.message}`);
        }
    } catch (error) {
        debugLog(`❌ Table Fetch Error: ${error.message}`);
    }
}

// Render table data
function renderTableData() {
    const tableBody = document.getElementById('table-body');
    if (!tableBody) return;

    tableBody.innerHTML = '';

    // Combine all tasks from different statuses
    const allTasks = [
        ...(currentTasksData.notStarted || []),
        ...(currentTasksData.inProgress || []),
        ...(currentTasksData.completed || []),
        ...(currentTasksData.cancelled || [])
    ];

    allTasks.forEach(task => {
        const priorityInfo = getPriorityInfo(task.priority);
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${task.id}</td>
            <td>${task.title || 'Untitled'}</td>
            <td>${(task.description || 'No description').substring(0, 50)}...</td>
            <td>
                <span class="status-badge" style="${getStatusStyle(task.status)} padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold;">
                    ${task.status}
                </span>
            </td>
            <td>
                <span class="priority-badge" style="background: ${priorityInfo.color}; color: #495057; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; border: 1px solid rgba(108, 117, 125, 0.2);">
                    ${priorityInfo.text}
                </span>
            </td>
            <td>
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar" style="width: ${task.progress || 0}%; background-color: #6c757d !important;">${task.progress || 0}%</div>
                </div>
            </td>
            <td>${task.dueDate || 'No due date'}</td>
            <td>
                <button class="btn btn-sm btn-outline-primary table-edit-btn" onclick="openTaskEditModal(${task.id}, this)" title="Edit Task" data-task-data='${JSON.stringify(task).replace(/'/g, "&apos;")}'>
                    <i class="fas fa-edit"></i> Edit
                </button>
            </td>
        `;
        tableBody.appendChild(row);
    });

    debugLog(`✅ Rendered ${allTasks.length} tasks in table`);
}

// Get status color for badges (softer colors)
function getStatusColor(status) {
    switch(status) {
        case 'NotStarted': return 'light';
        case 'InProgress': return 'info';      // Softer blue instead of primary
        case 'Completed': return 'light';      // Light instead of strong green
        case 'Cancelled': return 'secondary';  // Grey instead of red
        default: return 'light';
    }
}

// Get custom status styling for softer appearance
function getStatusStyle(status) {
    switch(status) {
        case 'NotStarted':
            return 'background: rgba(248, 249, 250, 0.8); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.3);';
        case 'InProgress':
            return 'background: rgba(173, 216, 230, 0.3); color: #0c5460; border: 1px solid rgba(23, 162, 184, 0.3);';
        case 'Completed':
            return 'background: rgba(144, 238, 144, 0.3); color: #0f5132; border: 1px solid rgba(40, 167, 69, 0.3);';
        case 'Cancelled':
            return 'background: rgba(248, 249, 250, 0.8); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.3);';
        default:
            return 'background: rgba(248, 249, 250, 0.8); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.3);';
    }
}

// Get priority color and text (pastel)
function getPriorityInfo(priority) {
    const priorityMap = {
        1: { text: 'Low', color: 'rgba(144, 238, 144, 0.4)' },     // Very light pastel green
        2: { text: 'Medium', color: 'rgba(173, 216, 230, 0.4)' },  // Very light pastel blue
        3: { text: 'High', color: 'rgba(255, 218, 185, 0.4)' },    // Very light pastel peach
        4: { text: 'Critical', color: 'rgba(255, 182, 193, 0.4)' } // Very light pastel pink
    };
    return priorityMap[priority] || { text: 'Medium', color: 'rgba(211, 211, 211, 0.4)' };
}

// Edit task from table (now uses unified modal)
// This function is no longer needed as we use openTaskEditModal directly

// Load data for Gantt view
async function loadGanttData() {
    debugLog('📈 Loading Gantt data...');

    try {
        const response = await fetch('/Tasks/GetKanbanData');
        const result = await response.json();

        if (result.success) {
            currentTasksData = result.data;
            renderGanttChart();
        } else {
            debugLog(`❌ Gantt API Error: ${result.message}`);
        }
    } catch (error) {
        debugLog(`❌ Gantt Fetch Error: ${error.message}`);
    }
}

// Render Gantt chart
function renderGanttChart() {
    const ganttContainer = document.getElementById('gantt-timeline');
    if (!ganttContainer) return;

    ganttContainer.innerHTML = '';

    // Combine all tasks
    const allTasks = [
        ...(currentTasksData.notStarted || []),
        ...(currentTasksData.inProgress || []),
        ...(currentTasksData.completed || []),
        ...(currentTasksData.cancelled || [])
    ];

    // Create simple Gantt chart
    const ganttHTML = `
        <div class="gantt-header" style="display: grid; grid-template-columns: 200px 1fr; gap: 10px; margin-bottom: 20px;">
            <div style="font-weight: bold; padding: 10px; background: #343a40; color: white; border-radius: 5px;">Task</div>
            <div style="font-weight: bold; padding: 10px; background: #343a40; color: white; border-radius: 5px;">Timeline</div>
        </div>
        <div class="gantt-body">
            ${allTasks.map(task => `
                <div class="gantt-row" style="display: grid; grid-template-columns: 200px 1fr; gap: 10px; margin-bottom: 10px;">
                    <div class="task-info" style="padding: 10px; background: white; border: 1px solid #ddd; border-radius: 5px;">
                        <div style="font-weight: bold; font-size: 12px;">${task.title || 'Untitled'}</div>
                        <div style="font-size: 10px; color: #666;">ID: ${task.id}</div>
                        <div style="font-size: 10px;">
                            <span style="background: ${getGanttPriorityColor(task.priority)}; color: #495057; padding: 2px 6px; border-radius: 8px; font-size: 9px; font-weight: bold; border: 1px solid rgba(108, 117, 125, 0.2);">
                                ${['', 'Low', 'Medium', 'High', 'Critical'][task.priority] || 'Medium'}
                            </span>
                        </div>
                    </div>
                    <div class="task-timeline" style="padding: 10px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 5px; position: relative;">
                        <div class="progress-bar" style="
                            background: ${getGanttProgressColor(task.priority)};
                            height: 20px;
                            width: ${task.progress || 0}%;
                            border-radius: 10px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: white;
                            font-size: 11px;
                            font-weight: bold;
                        ">
                            ${task.progress || 0}%
                        </div>
                        <div style="font-size: 10px; color: #666; margin-top: 5px;">
                            Due: ${task.dueDate || 'No due date'}
                        </div>
                    </div>
                </div>
            `).join('')}
        </div>
    `;

    ganttContainer.innerHTML = ganttHTML;
    debugLog(`✅ Rendered ${allTasks.length} tasks in Gantt chart`);
}

// Get Gantt color based on priority (keeping progress bars grey)
function getGanttProgressColor(priority) {
    // Always return grey for progress bars to maintain consistency
    return '#6c757d';
}

// Get priority color for Gantt labels (pastel)
function getGanttPriorityColor(priority) {
    const priorityColors = {
        1: 'rgba(144, 238, 144, 0.4)',  // Low - Very light pastel green
        2: 'rgba(173, 216, 230, 0.4)',  // Medium - Very light pastel blue
        3: 'rgba(255, 218, 185, 0.4)',  // High - Very light pastel peach
        4: 'rgba(255, 182, 193, 0.4)'   // Critical - Very light pastel pink
    };
    return priorityColors[priority] || 'rgba(211, 211, 211, 0.4)';
}
