}

// Initialize drag and drop
function initDragDrop() {
    debugLog('🎯 Initializing drag and drop...');

    const containers = ['todo-container', 'progress-container', 'completed-container', 'cancelled-container'];

    containers.forEach(containerId => {
        const container = document.getElementById(containerId);
        if (!container) {
            debugLog(`❌ Container ${containerId} not found for drag/drop`);
            return;
        }

        // Make container a drop zone
        container.addEventListener('dragover', handleDragOver);
        container.addEventListener('drop', handleDrop);
        container.addEventListener('dragenter', handleDragEnter);
        container.addEventListener('dragleave', handleDragLeave);

        debugLog(`✅ Drag/drop enabled for ${containerId}`);
    });

    // Make existing tasks draggable
    makeTasksDraggable();

    debugLog('✅ Drag and drop initialized successfully');
}

// Make all tasks draggable
function makeTasksDraggable() {
    const taskCards = document.querySelectorAll('.task-card');
    taskCards.forEach(card => {
        card.draggable = true;
        card.addEventListener('dragstart', handleDragStart);
        card.addEventListener('dragend', handleDragEnd);
        card.style.cursor = 'grab';
    });
    debugLog(`✅ Made ${taskCards.length} tasks draggable`);
}

// Drag and drop event handlers
let draggedElement = null;

function handleDragStart(e) {
    draggedElement = e.target;
    e.target.style.opacity = '0.5';
    e.target.style.transform = 'rotate(5deg)';
    debugLog(`🎯 Started dragging: ${e.target.querySelector('div').textContent}`);
}

function handleDragEnd(e) {
    e.target.style.opacity = '1';
    e.target.style.transform = 'none';
    draggedElement = null;
    debugLog('🎯 Drag ended');
}

function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
}

function handleDragEnter(e) {
    e.preventDefault();
    if (e.target.classList.contains('task-container')) {
        e.target.style.background = '#ffffcc';
        e.target.style.border = '3px dashed #007bff';
    }
}

function handleDragLeave(e) {
    if (e.target.classList.contains('task-container')) {
        e.target.style.background = '';
        e.target.style.border = '2px dashed #dee2e6';
    }
}

function handleDrop(e) {
    e.preventDefault();

    const dropContainer = e.target.closest('.task-container');
    if (!dropContainer || !draggedElement) {
        debugLog('❌ Invalid drop target or no dragged element');
        return;
    }

    // Reset container styles
    dropContainer.style.background = '';
    dropContainer.style.border = '2px dashed #dee2e6';

    // Get task info
    const taskTitle = draggedElement.querySelector('div').textContent;
    const fromContainer = draggedElement.parentElement.id;
    const toContainer = dropContainer.id;

    if (fromContainer === toContainer) {
        debugLog('⚠️ Dropped in same container');
        return;
    }

    // Move the task
    dropContainer.appendChild(draggedElement);

    // Update the container indicator in the task
    const containerIndicator = draggedElement.querySelector('div:last-child');
    if (containerIndicator) {
        containerIndicator.textContent = `📍 ${toContainer}`;
    }

    debugLog(`✅ Moved "${taskTitle}" from ${fromContainer} to ${toContainer}`);

    // If it's a real task with an ID, update via API
    const taskId = draggedElement.getAttribute('data-task-id');
    if (taskId) {
        updateTaskStatus(taskId, toContainer);
    }
}

// Update task status via API
async function updateTaskStatus(taskId, containerId) {
    debugLog(`📡 Updating task ${taskId} status via API...`);

    // Map container to status
    const statusMap = {
        'todo-container': 'NotStarted',
        'progress-container': 'InProgress',
        'completed-container': 'Completed',
        'cancelled-container': 'Cancelled'
    };

    const newStatus = statusMap[containerId];
    if (!newStatus) {
        debugLog(`❌ Unknown container: ${containerId}`);
        return;
    }

    try {
        const response = await fetch('/Tasks/UpdateKanbanOrder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                taskId: parseInt(taskId),
                newStatus: newStatus,
                newOrder: 1
            })
        });

        const result = await response.json();

        if (result.success) {
            debugLog(`✅ Task ${taskId} updated to ${newStatus} successfully`);
        } else {
            debugLog(`❌ API Error: ${result.message}`);
        }
    } catch (error) {
        debugLog(`❌ Update Error: ${error.message}`);
    }
}

// Global variables for auto-refresh
let autoRefreshInterval = null;
let refreshCountdown = 30;

// Auto-load real data on page load
document.addEventListener('DOMContentLoaded', function() {
    debugLog('🚀 Page loaded - initializing dashboard...');

    // Initialize view switcher
    debugLog('🔄 Initializing view switcher...');

    // Make sure Kanban is the default view
    showKanban();

    // Load real data immediately
    setTimeout(() => {
        loadRealData();
        setTimeout(() => {
            initDragDrop();
            startAutoRefresh();
        }, 1000);
    }, 500);
});

// Start automatic refresh
function startAutoRefresh() {
    debugLog('⏰ Starting auto-refresh every 30 seconds...');

    // Clear any existing interval
    if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
    }

    // Start countdown timer
    autoRefreshInterval = setInterval(() => {
        refreshCountdown--;
        updateRefreshTimer();

        if (refreshCountdown <= 0) {
            // Refresh data
            loadRealData();
            refreshCountdown = 30; // Reset countdown

            // Add visual feedback to refresh icon
            const refreshIcon = document.getElementById('refreshIcon');
            if (refreshIcon) {
                refreshIcon.style.animation = 'spin 1s linear';
                setTimeout(() => {
                    refreshIcon.style.animation = '';
                }, 1000);
            }
        }
    }, 1000);
}

// Update refresh timer display
function updateRefreshTimer() {
    const timerElement = document.getElementById('refreshTimer');
    if (timerElement) {
        timerElement.textContent = refreshCountdown + 's';
    }
}

// ========== SEARCH FUNCTIONALITY ==========

// Filter tasks based on search input
function filterTasks() {
    const searchTerm = document.getElementById('taskSearchInput').value.toLowerCase().trim();
    const searchResults = document.getElementById('searchResults');

    if (searchTerm === '') {
        // Show all tasks
        showAllTasks();
        searchResults.textContent = '';
        return;
    }

    let visibleCount = 0;
    let totalCount = 0;

    // Filter Kanban cards
    const taskCards = document.querySelectorAll('.task-card');
    taskCards.forEach(card => {
        totalCount++;
        const taskData = JSON.parse(card.getAttribute('data-task-data') || '{}');
        const title = (taskData.title || '').toLowerCase();
        const description = (taskData.description || '').toLowerCase();
        const id = (taskData.id || '').toString();

        const matches = title.includes(searchTerm) ||
                       description.includes(searchTerm) ||
                       id.includes(searchTerm);

        if (matches) {
            card.style.display = 'block';
            card.style.opacity = '1';
            visibleCount++;
        } else {
            card.style.display = 'none';
            card.style.opacity = '0.3';
        }
    });

    // Filter table rows
    const tableRows = document.querySelectorAll('#table-body tr');
    tableRows.forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length > 0) {
            const rowText = Array.from(cells).map(cell => cell.textContent.toLowerCase()).join(' ');

            if (rowText.includes(searchTerm)) {
                row.style.display = 'table-row';
            } else {
                row.style.display = 'none';
            }
        }
    });

    // Update search results
    searchResults.textContent = `Showing ${visibleCount} of ${totalCount} tasks`;
    debugLog(`🔍 Search "${searchTerm}": ${visibleCount}/${totalCount} tasks found`);
}

// Show all tasks (clear filter)
function showAllTasks() {
    // Show all Kanban cards
    const taskCards = document.querySelectorAll('.task-card');
    taskCards.forEach(card => {
        card.style.display = 'block';
        card.style.opacity = '1';
    });

    // Show all table rows
    const tableRows = document.querySelectorAll('#table-body tr');
    tableRows.forEach(row => {
        row.style.display = 'table-row';
    });
}

// Clear search
function clearSearch() {
    document.getElementById('taskSearchInput').value = '';
    showAllTasks();
    document.getElementById('searchResults').textContent = '';
    debugLog('🔍 Search cleared - showing all tasks');
}

// ========== TASK EDITING FUNCTIONS ==========

// Open task edit modal
function openTaskEditModal(taskId, buttonElement = null) {
    debugLog(`✏️ Opening edit modal for task ${taskId}`);

    let taskData = null;

    // Try to get task data from button element first (for table view)
    if (buttonElement && buttonElement.hasAttribute('data-task-data')) {
        try {
            taskData = JSON.parse(buttonElement.getAttribute('data-task-data'));
            debugLog('📊 Using task data from table button');
        } catch (e) {
            debugLog('❌ Error parsing table button data, falling back to global data');
        }
    }

    // If no data from button, try to find in global currentTasksData
    if (!taskData && currentTasksData) {
        const allTasks = [
            ...(currentTasksData.notStarted || []),
            ...(currentTasksData.inProgress || []),
            ...(currentTasksData.completed || []),
            ...(currentTasksData.cancelled || [])
        ];
        taskData = allTasks.find(task => task.id == taskId);
        if (taskData) {
            debugLog('🌐 Using task data from global data');
        }
    }

    // Last resort: try to find from Kanban card
    if (!taskData) {
        const taskCard = document.querySelector(`[data-task-id="${taskId}"]`);
        if (taskCard && taskCard.hasAttribute('data-task-data')) {
            try {
                taskData = JSON.parse(taskCard.getAttribute('data-task-data'));
                debugLog('📋 Using task data from Kanban card');
            } catch (e) {
                debugLog('❌ Error parsing Kanban card data');
            }
        }
    }

    if (!taskData) {
        debugLog(`❌ No task data found for ID ${taskId}`);
        alert('Error: Task data not found. Please refresh the page and try again.');
        return;
    }

    // Populate modal fields
    document.getElementById('editTaskId').value = taskData.id;
    document.getElementById('editTaskTitle').value = taskData.title || '';
    document.getElementById('editTaskDescription').value = taskData.description || '';
    document.getElementById('editTaskStatus').value = taskData.status || 'NotStarted';
    document.getElementById('editTaskPriority').value = taskData.priority || 2;
    document.getElementById('editTaskDueDate').value = taskData.dueDate || '';
    document.getElementById('editTaskEstimatedHours').value = taskData.estimatedHours || 0;
    document.getElementById('editTaskActualHours').value = taskData.actualHours || 0;

    // Set progress slider and initialize
    const progressSlider = document.getElementById('editTaskProgress');
    const progressValue = document.getElementById('progressValue');
    const initialProgress = taskData.progress || 0;

    progressSlider.value = initialProgress;
    progressValue.textContent = initialProgress + '%';
    updateProgressSliderBackground(progressSlider, initialProgress);

    // Add progress slider event listener
    progressSlider.addEventListener('input', function() {
        const value = this.value;
        progressValue.textContent = value + '%';
        progressValue.classList.add('updating');
        updateProgressSliderBackground(this, value);

        // Remove updating class after animation
        setTimeout(() => {
            progressValue.classList.remove('updating');
        }, 300);
    });

    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('taskEditModal'));
    modal.show();

    debugLog(`✅ Edit modal opened for "${taskData.title}" with ${initialProgress}% progress`);
}

// Update progress slider background
function updateProgressSliderBackground(slider, value) {
    const percentage = value;
    const gradient = `linear-gradient(to right, #6c757d 0%, #6c757d ${percentage}%, #e9ecef ${percentage}%, #e9ecef 100%)`;
    slider.style.background = gradient;

    // Unified grey color for progress value
    const progressValue = document.getElementById('progressValue');
    progressValue.style.color = '#6c757d';
}

// Save task changes
async function saveTaskChanges() {
    debugLog('💾 Saving task changes...');

    const taskData = {
        id: parseInt(document.getElementById('editTaskId').value),
        title: document.getElementById('editTaskTitle').value,
        description: document.getElementById('editTaskDescription').value,
        status: document.getElementById('editTaskStatus').value,
        priority: parseInt(document.getElementById('editTaskPriority').value),
        progress: parseInt(document.getElementById('editTaskProgress').value),
        dueDate: document.getElementById('editTaskDueDate').value,
        estimatedHours: parseInt(document.getElementById('editTaskEstimatedHours').value),
        actualHours: parseInt(document.getElementById('editTaskActualHours').value)
    };

    debugLog(`Task data to save: ${JSON.stringify(taskData)}`);

    try {
        const response = await fetch('/Tasks/UpdateTask', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(taskData)
        });

        const result = await response.json();

        if (result.success) {
            debugLog(`✅ Task ${taskData.id} updated successfully`);

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('taskEditModal'));
            modal.hide();

            // Refresh all data and views
            setTimeout(() => {
                loadRealData();
                // Also refresh table and gantt if they're currently visible
                const currentView = document.querySelector('.view-switcher .btn.active');
                if (currentView) {
                    const viewId = currentView.id;
                    if (viewId === 'tableBtn') {
                        setTimeout(() => loadTableData(), 500);
                    } else if (viewId === 'ganttBtn') {
                        setTimeout(() => loadGanttData(), 500);
                    }
                }
            }, 200);

            // Show success message
            showSuccessMessage('Task updated successfully!');
        } else {
            debugLog(`❌ Update failed: ${result.message}`);
            showErrorMessage('Failed to update task: ' + result.message);
        }
    } catch (error) {
        debugLog(`❌ Update error: ${error.message}`);
        showErrorMessage('Error updating task: ' + error.message);
    }
}

// Show success message
function showSuccessMessage(message) {
    const alert = document.createElement('div');
    alert.className = 'alert alert-success alert-dismissible fade show';
    alert.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alert.innerHTML = `
        <i class="fas fa-check-circle"></i> ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alert);

    setTimeout(() => {
        if (alert.parentNode) {
            alert.parentNode.removeChild(alert);
        }
    }, 5000);
}

// Show error message
function showErrorMessage(message) {
    const alert = document.createElement('div');
    alert.className = 'alert alert-danger alert-dismissible fade show';
    alert.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alert.innerHTML = `
        <i class="fas fa-exclamation-circle"></i> ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alert);

    setTimeout(() => {
        if (alert.parentNode) {
            alert.parentNode.removeChild(alert);
        }
    }, 5000);
}

// Update quick stats
function updateQuickStats() {
    if (!currentTasksData) return;

    const stats = {
        total: 0,
        notStarted: currentTasksData.notStarted?.length || 0,
        inProgress: currentTasksData.inProgress?.length || 0,
        completed: currentTasksData.completed?.length || 0,
        cancelled: currentTasksData.cancelled?.length || 0
    };

    stats.total = stats.notStarted + stats.inProgress + stats.completed + stats.cancelled;

    // Update total count in header
    const totalCount = document.getElementById('totalTasksCount');
    if (totalCount) {
        totalCount.textContent = stats.total;
    }

    // Update quick stats
    const quickStats = document.getElementById('quickStats');
    if (quickStats) {
        quickStats.innerHTML = `
            <div class="stat-item" style="text-align: center;">
                <div style="font-size: 1.5rem; font-weight: bold; color: #6c757d;">${stats.notStarted}</div>
                <div style="font-size: 0.8rem; color: #666;">To Do</div>
            </div>
            <div class="stat-item" style="text-align: center;">
                <div style="font-size: 1.5rem; font-weight: bold; color: #007bff;">${stats.inProgress}</div>
                <div style="font-size: 0.8rem; color: #666;">In Progress</div>
            </div>
            <div class="stat-item" style="text-align: center;">
                <div style="font-size: 1.5rem; font-weight: bold; color: #28a745;">${stats.completed}</div>
                <div style="font-size: 0.8rem; color: #666;">Completed</div>
            </div>
            <div class="stat-item" style="text-align: center;">
                <div style="font-size: 1.5rem; font-weight: bold; color: #dc3545;">${stats.cancelled}</div>
                <div style="font-size: 0.8rem; color: #666;">Cancelled</div>
