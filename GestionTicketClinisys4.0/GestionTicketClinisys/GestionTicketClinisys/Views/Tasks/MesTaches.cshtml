@model IEnumerable<GestionTicketClinisys.Models.TaskItem>

@{
    ViewData["Title"] = "Mes Tâches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Ensure FontAwesome is loaded -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Enhanced Header -->
            <div class="page-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 15px; margin-bottom: 30px; box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="mb-2" style="font-weight: bold; font-size: 2.5rem;">
                            <i class="fas fa-tasks me-3"></i>Task Management Dashboard
                        </h1>
                        <p class="mb-0" style="font-size: 1.1rem; opacity: 0.9;">
                            Organize, track, and manage your tasks efficiently
                        </p>
                    </div>
                    <div class="header-stats" style="text-align: right;">
                        <div style="font-size: 2rem; font-weight: bold;" id="totalTasksCount">0</div>
                        <div style="font-size: 0.9rem; opacity: 0.8;">Total Tasks</div>
                    </div>
                </div>
            </div>

            <div class="control-panel" style="margin: 20px 0; padding: 20px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <!-- Left side: Search Bar -->
                    <div class="search-container" style="flex: 1; max-width: 450px;">
                        <div class="input-group">
                            <span class="input-group-text" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-color: #dee2e6; color: #667eea;">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" id="taskSearchInput" placeholder="Search tasks by title, description, or ID..."
                                   style="border-color: #dee2e6; font-size: 14px;" onkeyup="filterTasks()">
                            <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()" title="Clear Search" style="border-color: #dee2e6;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div id="searchResults" style="margin-top: 8px; font-size: 12px; color: #666; font-style: italic;"></div>
                    </div>

                    <!-- Right side: Controls and Stats -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Enhanced Control Buttons -->
                        <div class="control-buttons d-flex align-items-center gap-2">
                            <button onclick="loadRealData()" class="btn btn-primary enhanced-btn" title="Manual Refresh" style="
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                                border: none;
                                border-radius: 8px;
                                padding: 10px 16px;
                                font-weight: bold;
                                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
                                transition: all 0.3s ease;
                            ">
                                <i class="fas fa-sync-alt me-2" id="refreshIcon"></i>
                                Refresh
                            </button>
                            <button onclick="clearAll()" class="btn btn-outline-warning enhanced-btn" title="Clear All" style="
                                border: 2px solid #ffc107;
                                border-radius: 8px;
                                padding: 10px 16px;
                                font-weight: bold;
                                color: #856404;
                                background: rgba(255, 193, 7, 0.1);
                                transition: all 0.3s ease;
                            ">
                                <i class="fas fa-broom me-2"></i>
                                Clear
                            </button>
                        </div>

                        <!-- Auto-refresh indicator -->
                        <div class="auto-refresh-indicator" style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgba(40, 167, 69, 0.1); border-radius: 20px; border: 1px solid rgba(40, 167, 69, 0.2);">
                            <div class="auto-refresh-dot" style="width: 8px; height: 8px; background: #28a745; border-radius: 50%; animation: pulse-dot 2s infinite;"></div>
                            <span style="font-size: 12px; color: #155724; font-weight: 500;">Auto: <span id="refreshTimer">30s</span></span>
                        </div>

                        <!-- Quick stats -->
                        <div class="quick-stats" id="quickStats" style="display: flex; gap: 15px;">
                            <!-- Quick stats will be populated here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- View Switcher -->
            <div class="view-switcher" style="margin: 20px 0; text-align: center;">
                <button type="button" onclick="showKanban()" class="btn btn-outline-primary active" id="kanbanBtn">📋 Kanban</button>
                <button type="button" onclick="showTable()" class="btn btn-outline-secondary" id="tableBtn">📊 Table</button>
                <button type="button" onclick="showGantt()" class="btn btn-outline-info" id="ganttBtn">📈 Gantt</button>
            </div>

            <!-- Simple Kanban Board -->
            <div class="simple-kanban" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 20px;">
                
                <!-- To Do Column -->
                <div class="kanban-col" style="background: #f8f9fa; border-radius: 8px; padding: 15px; min-height: 400px;">
                    <h4 style="text-align: center; color: #6c757d; margin-bottom: 15px;">
                        📋 To Do
                    </h4>
                    <div id="todo-container" class="task-container" style="min-height: 300px; border: 2px dashed #dee2e6; border-radius: 5px; padding: 10px;">
                        <!-- Tasks will be added here -->
                    </div>
                </div>

                <!-- In Progress Column -->
                <div class="kanban-col" style="background: rgba(173, 216, 230, 0.15); border-radius: 8px; padding: 15px; min-height: 400px;">
                    <h4 style="text-align: center; color: rgba(23, 162, 184, 0.8); margin-bottom: 15px;">
                        🔄 In Progress
                    </h4>
                    <div id="progress-container" class="task-container" style="min-height: 300px; border: 2px dashed rgba(173, 216, 230, 0.5); border-radius: 5px; padding: 10px;">
                        <!-- Tasks will be added here -->
                    </div>
                </div>

                <!-- Completed Column -->
                <div class="kanban-col" style="background: rgba(144, 238, 144, 0.15); border-radius: 8px; padding: 15px; min-height: 400px;">
                    <h4 style="text-align: center; color: rgba(40, 167, 69, 0.8); margin-bottom: 15px;">
                        ✅ Completed
                    </h4>
                    <div id="completed-container" class="task-container" style="min-height: 300px; border: 2px dashed rgba(144, 238, 144, 0.5); border-radius: 5px; padding: 10px;">
                        <!-- Tasks will be added here -->
                    </div>
                </div>

                <!-- Cancelled Column -->
                <div class="kanban-col" style="background: #ffebee; border-radius: 8px; padding: 15px; min-height: 400px;">
                    <h4 style="text-align: center; color: #d32f2f; margin-bottom: 15px;">
                        ❌ Cancelled
                    </h4>
                    <div id="cancelled-container" class="task-container" style="min-height: 300px; border: 2px dashed #ef9a9a; border-radius: 5px; padding: 10px;">
                        <!-- Tasks will be added here -->
                    </div>
                </div>

            </div>

            <!-- Table View -->
            <div id="table-view" style="display: none; margin-top: 20px;">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="fas fa-table"></i> Tasks Table View</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="tasks-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Progress</th>
                                        <th>Due Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="table-body">
                                    <!-- Table rows will be added here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gantt View -->
            <div id="gantt-view" style="display: none; margin-top: 20px;">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="fas fa-chart-gantt"></i> Gantt Chart View</h4>
                    </div>
                    <div class="card-body">
                        <div id="gantt-container" style="min-height: 400px; background: #f8f9fa; border-radius: 8px; padding: 20px;">
                            <div id="gantt-timeline">
                                <!-- Gantt chart will be rendered here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Task Edit Modal -->
            <div class="modal fade" id="taskEditModal" tabindex="-1" aria-labelledby="taskEditModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                            <h5 class="modal-title" id="taskEditModalLabel">
                                <i class="fas fa-edit"></i> Edit Task
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editTaskForm">
                                <input type="hidden" id="editTaskId">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label for="editTaskTitle" class="form-label">Title</label>
                                            <input type="text" class="form-control" id="editTaskTitle" required>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label for="editTaskStatus" class="form-label">Status</label>
                                            <select class="form-select" id="editTaskStatus">
                                                <option value="NotStarted">Not Started</option>
                                                <option value="InProgress">In Progress</option>
                                                <option value="Completed">Completed</option>
                                                <option value="Cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="editTaskDescription" class="form-label">Description</label>
                                    <textarea class="form-control" id="editTaskDescription" rows="3"></textarea>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label for="editTaskPriority" class="form-label">Priority</label>
                                            <select class="form-select" id="editTaskPriority">
                                                <option value="1">Low</option>
                                                <option value="2">Medium</option>
                                                <option value="3">High</option>
                                                <option value="4">Critical</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label for="editTaskProgress" class="form-label">
                                                Progress: <span id="progressValue" style="font-weight: bold; color: #667eea;">0%</span>
                                            </label>
                                            <div class="progress-slider-container" style="margin-top: 10px;">
                                                <input type="range" class="form-range progress-slider" id="editTaskProgress"
                                                       min="0" max="100" value="0"
                                                       style="width: 100%; height: 8px; background: linear-gradient(to right, #667eea 0%, #667eea 0%, #e9ecef 0%, #e9ecef 100%); border-radius: 5px; outline: none; cursor: pointer;">
                                                <div class="progress-labels" style="display: flex; justify-content: space-between; margin-top: 5px; font-size: 12px; color: #666;">
                                                    <span>0%</span>
                                                    <span>25%</span>
                                                    <span>50%</span>
                                                    <span>75%</span>
                                                    <span>100%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label for="editTaskDueDate" class="form-label">Due Date</label>
                                            <input type="date" class="form-control" id="editTaskDueDate">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="editTaskEstimatedHours" class="form-label">Estimated Hours</label>
                                            <input type="number" class="form-control" id="editTaskEstimatedHours" min="0">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="editTaskActualHours" class="form-label">Actual Hours</label>
                                            <input type="number" class="form-control" id="editTaskActualHours" min="0">
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button type="button" class="btn btn-primary" onclick="saveTaskChanges()">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Debug Info - Commented out for production -->
            <!--
            <div id="debug-info" style="margin-top: 30px; padding: 15px; background: #f1f3f4; border-radius: 8px; font-family: monospace; font-size: 12px;">
                <strong>Debug Output:</strong>
                <div id="debug-output"></div>
            </div>
            -->
        </div>
    </div>
</div>

<style>
/* Drag and Drop Styles */
.task-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.15) !important;
}

.task-card:active {
    cursor: grabbing !important;
}

.task-container {
    transition: all 0.3s ease;
}

.task-container.drag-over {
    background: #ffffcc !important;
    border: 3px dashed #007bff !important;
    transform: scale(1.02);
}

/* Dragging state */
.task-card.dragging {
    opacity: 0.5;
    transform: rotate(5deg);
    z-index: 1000;
}

/* Drop zone highlight */
.drop-zone-active {
    background: linear-gradient(45deg, #e3f2fd, #f3e5f5) !important;
    border: 3px dashed #2196f3 !important;
    animation: pulse 1s infinite;
}

@@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.02); }
    100% { transform: scale(1); }
}

/* Success animation */
.task-moved {
    animation: taskMoved 0.5s ease;
}

@@keyframes taskMoved {
    0% { transform: scale(1); background: white; }
    50% { transform: scale(1.1); background: #d4edda; }
    100% { transform: scale(1); background: white; }
}

/* View Switcher Styles */
.view-switcher .btn {
    margin: 0 5px;
    border-radius: 25px;
    padding: 8px 20px;
    font-weight: bold;
    transition: all 0.3s ease;
}

.view-switcher .btn.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-color: #667eea;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

/* Table View Styles */
.table-responsive {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.table th {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    padding: 15px;
    font-weight: bold;
}

.table td {
    padding: 12px 15px;
    vertical-align: middle;
    border-color: #e9ecef;
}

.table tbody tr:hover {
    background-color: #f8f9fa;
    transform: scale(1.01);
    transition: all 0.2s ease;
}

/* Gantt Chart Styles */
.gantt-row:hover {
    transform: translateX(5px);
    transition: all 0.3s ease;
}

.gantt-row .task-info:hover {
    background: #e3f2fd !important;
    border-color: #2196f3 !important;
}

.gantt-row .task-timeline:hover {
    background: #fff3e0 !important;
    border-color: #ff9800 !important;
}

/* Card improvements */
.card {
    border: none;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    overflow: hidden;
}

.card-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    padding: 20px;
}

.card-header h4 {
    margin: 0;
    font-weight: bold;
}

/* Progress Slider Styles */
.progress-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 8px;
    border-radius: 5px;
    background: #e9ecef;
    outline: none;
    transition: all 0.3s ease;
}

.progress-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
    transition: all 0.3s ease;
}

.progress-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.5);
}

.progress-slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    cursor: pointer;
    border: none;
    box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
    transition: all 0.3s ease;
}

.progress-slider::-moz-range-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.5);
}

.progress-slider::-ms-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    cursor: pointer;
    border: none;
    box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
    transition: all 0.3s ease;
}

.progress-slider-container {
    position: relative;
}

.progress-labels span {
    font-size: 11px;
    color: #999;
    font-weight: 500;
}

/* Progress value animation */
#progressValue {
    transition: all 0.3s ease;
    display: inline-block;
}

#progressValue.updating {
    transform: scale(1.1);
    color: #28a745 !important;
}

/* Enhanced Button Styles */
.enhanced-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: bold;
    transition: all 0.3s ease;
    text-decoration: none;
    white-space: nowrap;
}

.enhanced-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
}

.enhanced-btn i {
    font-size: 14px;
    display: inline-block;
    width: auto;
    height: auto;
}

.enhanced-btn .me-2 {
    margin-right: 8px !important;
}

/* Specific button hover effects */
.btn-primary.enhanced-btn:hover {
    background: linear-gradient(135deg, #5a6fd8 0%, #6a4c93 100%) !important;
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4) !important;
}

.btn-outline-warning.enhanced-btn:hover {
    background: rgba(255, 193, 7, 0.2) !important;
    border-color: #e0a800 !important;
    color: #856404 !important;
    box-shadow: 0 6px 20px rgba(255, 193, 7, 0.3) !important;
}

/* Ensure FontAwesome icons display */
.fas, .fa {
    font-family: "Font Awesome 5 Free" !important;
    font-weight: 900 !important;
    display: inline-block !important;
}

/* Auto-refresh indicator styling */
.auto-refresh-indicator {
    font-size: 12px;
    border-radius: 20px;
    padding: 8px 12px;
    background: rgba(40, 167, 69, 0.1);
    border: 1px solid rgba(40, 167, 69, 0.2);
}

/* Search container enhancements */
.search-container .input-group-text {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-color: #dee2e6;
    color: #667eea;
    font-weight: bold;
}

.search-container .form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

/* Table action button improvements */
.table .btn-sm {
    padding: 6px 12px;
    font-size: 12px;
    border-radius: 20px;
    font-weight: bold;
    transition: all 0.3s ease;
}

.table .btn-sm:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(0,0,0,0.2);
}

/* Auto-refresh indicator */
@@keyframes pulse-dot {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
    100% { opacity: 1; transform: scale(1); }
}

@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.auto-refresh-indicator {
    font-size: 12px;
    color: #666;
}

/* Search container styling */
.search-container .input-group-text {
    background: #f8f9fa;
    border-color: #dee2e6;
}

.search-container .form-control {
    border-color: #dee2e6;
    transition: all 0.3s ease;
}

.search-container .form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

/* Search results styling */
#searchResults {
    font-style: italic;
    color: #6c757d;
}

/* Unified grey theme for progress bars only */
.progress .progress-bar {
    background-color: #6c757d !important;
}

/* Priority badges keep their colors */
.priority-badge {
    font-weight: bold;
    border-radius: 12px;
    padding: 4px 8px;
    font-size: 11px;
}

/* Task card fade effect for search */
.task-card {
    transition: opacity 0.3s ease, transform 0.3s ease;
}

.task-card.filtered {
    opacity: 0.3;
    transform: scale(0.95);
}
</style>

<script>
// Debug logging
function debugLog(message) {
    console.log(message);
    const debugOutput = document.getElementById('debug-output');
    if (debugOutput) {
        debugOutput.innerHTML += '<div>' + new Date().toLocaleTimeString() + ': ' + message + '</div>';
        debugOutput.scrollTop = debugOutput.scrollHeight;
    }
}

// Test if containers exist
function testContainers() {
    debugLog('🔍 Testing container existence...');
    
    const containers = ['todo-container', 'progress-container', 'completed-container', 'cancelled-container'];
    
    containers.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            debugLog(`✅ Found container: ${id}`);
            element.style.background = '#ffffcc';
            element.innerHTML = `<div style="padding: 10px; text-align: center; color: #333;">CONTAINER ${id} FOUND ✅</div>`;
        } else {
            debugLog(`❌ Container NOT found: ${id}`);
        }
    });
}

// Load test data
function loadTestData() {
    debugLog('🧪 Loading test data...');
    
    clearAll();
    
    // Add test tasks
    addTaskToContainer('todo-container', 'Test Task 1', 'This is a test task in To Do');
    addTaskToContainer('progress-container', 'Test Task 2', 'This is a test task in Progress');
    addTaskToContainer('completed-container', 'Test Task 3', 'This is a test task in Completed');
    
    debugLog('✅ Test data loaded successfully');
}

// Load real data from API
async function loadRealData() {
    debugLog('📊 Loading real data from API...');
    
    try {
        const response = await fetch('/Tasks/GetKanbanData');
        const result = await response.json();
        
        debugLog(`API Response: ${JSON.stringify(result)}`);
        
        if (result.success) {
            clearAll();
            renderRealData(result.data);
        } else {
            debugLog(`❌ API Error: ${result.message}`);
        }
    } catch (error) {
        debugLog(`❌ Fetch Error: ${error.message}`);
    }
}

// Render real data
function renderRealData(data) {
    debugLog('🎨 Rendering real data...');

    // Store data globally
    currentTasksData = data;

    if (data.notStarted) {
        data.notStarted.forEach(task => {
            addRealTaskToContainer('todo-container', task);
        });
    }

    if (data.inProgress) {
        data.inProgress.forEach(task => {
            addRealTaskToContainer('progress-container', task);
        });
    }

    if (data.completed) {
        data.completed.forEach(task => {
            addRealTaskToContainer('completed-container', task);
        });
    }

    if (data.cancelled) {
        data.cancelled.forEach(task => {
            addRealTaskToContainer('cancelled-container', task);
        });
    }

    // Update stats
    updateQuickStats();

    debugLog('✅ Real data rendered successfully');
}

