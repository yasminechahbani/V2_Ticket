    // CSV Export functionality
    function exportSelected() {
        if (selectedTickets.length === 0) {
            alert('Veuillez sélectionner au moins un ticket à exporter.');
            return;
        }

        console.log('Exporting tickets:', selectedTickets);

        // Create CSV content
        const headers = ['ID', 'Titre', 'Demandeur', 'Date', 'Statut', 'Priorité', 'Type', 'Utilisateur', 'Équipe', 'Module', 'Description'];
        let csvContent = headers.join(',') + '\n';

        // Get data from selected rows
        selectedTickets.forEach(ticketId => {
            const row = document.querySelector(`input[data-id="${ticketId}"]`).closest('tr');
            const cells = row.querySelectorAll('td');

            const rowData = [
                ticketId,
                `"${cells[1].textContent.trim()}"`, // Titre
                `"${cells[2].textContent.trim()}"`, // Demandeur
                `"${cells[3].textContent.trim()}"`, // Date
                `"${cells[4].textContent.trim()}"`, // Statut
                `"${cells[5].textContent.trim()}"`, // Priorité
                `"${cells[6].textContent.trim()}"`, // Type
                `"${cells[7].textContent.trim()}"`, // Utilisateur
                `"${cells[8].textContent.trim()}"`, // Équipe
                `"${cells[9].textContent.trim()}"`, // Module
                `"${cells[10] ? cells[10].textContent.trim() : ''}"` // Description (if exists)
            ];

            csvContent += rowData.join(',') + '\n';
        });

        // Download CSV file
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `tickets_export_${new Date().toISOString().split('T')[0]}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        console.log('CSV export completed');
        alert(`${selectedTickets.length} tickets exportés avec succès!`);
    }

    // Bulk delete functionality
    function deleteSelected() {
        if (selectedTickets.length === 0) {
            alert('Veuillez sélectionner au moins un ticket à supprimer.');
            return;
        }

        // Show confirmation dialog
        const ticketTitles = selectedTickets.map(ticketId => {
            const row = document.querySelector(`input[data-id="${ticketId}"]`).closest('tr');
            return row.querySelector('td:nth-child(2)').textContent.trim();
        });

        const confirmMessage = `Êtes-vous sûr de vouloir supprimer ${selectedTickets.length} ticket(s) ?\n\nTickets à supprimer:\n${ticketTitles.map(title => `- ${title}`).join('\n')}`;

        if (confirm(confirmMessage)) {
            bulkDeleteTickets();
        }
    }

