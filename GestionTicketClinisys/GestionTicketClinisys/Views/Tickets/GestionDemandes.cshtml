@model IEnumerable<GestionTicketClinisys.Models.Ticket>
@{
    ViewData["Title"] = "Gestion des Demandes";
}

<!-- Prevent caching -->
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<!-- Page version identifier -->
<meta name="page-version" content="3.0-@DateTime.Now.Ticks">
<link rel="stylesheet" href="~/css/GestionDemandes.css" />
<div class="header">
    <h1>GESTION DES DEMANDES</h1>
    <div class="header-actions">
        <button class="btn btn-success" onclick="openModal()">+ Demande</button>
        <button class="btn btn-secondary" id="exportBtn" onclick="exportSelected()" disabled>📤 Export CSV</button>
        <button class="btn btn-danger" id="deleteBtn" onclick="deleteSelected()" disabled>🗑️ Supprimer</button>
    </div>
</div>
<div class="controls">
    <div class="search-filters">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Rechercher..." />
        </div>
        <div class="filter-group">
            <label>Statut:</label>
            <select id="statusFilter">
                <option value="">Tous</option>
                <option value="Open">Open</option>
                <option value="InProgress">InProgress</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Type:</label>
            <select id="typeFilter">
                <option value="">Tous</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Developpement">Développement</option>
                <option value="Support">Support</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Priorité:</label>
            <select id="priorityFilter">
                <option value="">Tous</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
            </select>
        </div>
    </div>
    <div class="date-range">
        <label>Du:</label>
        <input type="date" id="dateFrom" />
        <label>Au:</label>
        <input type="date" id="dateTo" />
        <button class="btn btn-secondary" onclick="clearFilters()" style="margin-left: 10px;">🔄 Effacer</button>
    </div>
</div>
<div class="table-container">
    <table class="data-table" id="dataTable">
        <thead>
            <tr>
                <th><input type="checkbox" /></th>
                <th>Titre</th>
                <th>Demandeur</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Priorité</th>
                <th>Type</th>
                <th>Utilisateur</th>
                <th>Équipe</th>
                <th>Module</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><input type="checkbox" class="row-checkbox" data-id="@item.Id" /></td>
                <td>@item.Title</td>
                <td>@item.Client?.Name</td>
                <td>@item.CreationDate.ToString("yyyy-MM-dd")</td>
                <td><span class="status-badge status-@item.Status.ToString().ToLower()">@item.Status</span></td>
                <td><span class="priority-badge priority-@item.Priority.ToString().ToLower()">@item.Priority</span></td>
                <td>@(item.Type?.ToString() ?? "-")</td>
                <td>@(item.User?.UserName ?? "-")</td>
                <td>@(item.Team?.Name ?? "-")</td>
                <td>@(item.Module?.Name ?? "-")</td>
                <td>
                    <button class="btn btn-primary" onclick="openEditModal(@item.Id)" title="Modifier">✏️</button>
                    <button class="btn btn-danger" onclick="openDeleteModal(@item.Id, '@Html.Raw(Html.Encode(item.Title))')" title="Supprimer">🗑️</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="stats">
    <span id="recordCount">Total: @Model.Count() enregistrements</span>
    <span id="selectedCount">Sélectionnés: 0</span>
</div>
<div class="pagination" id="pagination">
</div>

<!-- Modal Dialog for Creating New Ticket -->
<div id="modalOverlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 99999;">
    <div id="modalContent" style="background: white; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto; position: relative; z-index: 100000; margin: 20px; padding: 0;">
        <div style="background-color: #2c5282; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0; font-size: 16px; font-weight: bold; position: relative;">
            GESTION DES DEMANDES
            <button onclick="closeModal()" style="position: absolute; top: 10px; right: 15px; background: none; border: none; color: white; font-size: 20px; cursor: pointer;">&times;</button>
        </div>

        <div style="padding: 20px;">
            <form id="requestForm">
                @Html.AntiForgeryToken()
                <div class="form-section">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="demandeur">Demandeur *</label>
                            <select id="demandeur" name="ClientId" required>
                                <option value="">Sélectionner...</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="duree">Durée</label>
                            <div class="duration-group">
                                <input type="number" id="dureeJours" name="DurationDays" class="duration-input" placeholder="Jrs">
                                <input type="number" id="dureeMois" name="DurationMonths" class="duration-input" placeholder="Mois">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="type">Type</label>
                            <select id="type" name="Type">
                                <option value="">Sélectionner...</option>
                                <option value="0">Maintenance</option>
                                <option value="1">Développement</option>
                                <option value="2">Support</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="status">Statut</label>
                            <select id="status" name="Status">
                                <option value="0">Open</option>
                                <option value="1">InProgress</option>
                                <option value="2">Resolved</option>
                                <option value="3">Closed</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="priority">Priorité</label>
                            <select id="priority" name="Priority">
                                <option value="0">Low</option>
                                <option value="1">Medium</option>
                                <option value="2">High</option>
                                <option value="3">Critical</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="designation">Titre *</label>
                            <input type="text" id="designation" name="Title" placeholder="Entrez le titre" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="description">Description *</label>
                            <textarea id="description" name="Description" rows="3" placeholder="Description du ticket" required></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="commentaire">Commentaire</label>
                            <div class="toolbar">
                                <button type="button" onclick="formatText('bold')" title="Gras"><b>B</b></button>
                                <button type="button" onclick="formatText('italic')" title="Italique"><i>I</i></button>
                                <button type="button" onclick="formatText('underline')" title="Souligner"><u>U</u></button>
                                <button type="button" onclick="formatText('strikethrough')" title="Barré"><s>S</s></button>
                                <button type="button" onclick="insertList('ul')" title="Liste à puces">•</button>
                                <button type="button" onclick="insertList('ol')" title="Liste numérotée">1.</button>
                                <button type="button" onclick="insertLink()" title="Insérer un lien">🔗</button>
                            </div>
                            <div class="text-editor" id="textEditor" contenteditable="true">
                                Tapez votre commentaire ici...
                            </div>
                            <input type="hidden" id="richTextComment" name="RichTextComment">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Télécharger Documents</label>
                            <div class="upload-section">
                                <input type="file" id="fileInput" class="file-input" multiple>
                                <button type="button" class="upload-btn" onclick="document.getElementById('fileInput').click()">
                                    Choisir des fichiers
                                </button>
                                <p>ou glissez-déposez vos fichiers ici</p>
                                <div id="fileList"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div style="padding: 15px 20px; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" onclick="closeModal()" style="padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; background-color: #6c757d; color: white;">Annuler</button>
            <button type="button" onclick="submitForm()" style="padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; background-color: #007bff; color: white;">Enregistrer</button>
        </div>
    </div>
</div>

