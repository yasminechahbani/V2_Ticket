                <strong>Titre:</strong> <span id="deleteTicketTitle"></span>
            </p>
            <p style="margin: 5px 0 0 0; font-size: 14px; color: #666;">
                Cette action est irréversible.
            </p>
            <input type="hidden" id="deleteTicketId">
        </div>

        <div style="padding: 15px 20px; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" onclick="closeDeleteModal()" style="padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; background-color: #6c757d; color: white;">Annuler</button>
            <button type="button" onclick="confirmDelete()" style="padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; background-color: #dc3545; color: white;">Supprimer</button>
        </div>
    </div>
</div>

