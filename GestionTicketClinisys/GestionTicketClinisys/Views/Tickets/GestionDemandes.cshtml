<script>
    let dropdownData = {};

    // Load dropdown data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Page loaded - Version 3.0 - ' + new Date().toISOString());

        // Remove any cached test elements
        const testElements = document.querySelectorAll('[style*="TEST"], [style*="test"], [style*="Modal is working"]');
        testElements.forEach(el => {
            console.log('Removing cached test element:', el);
            el.remove();
        });

        // Also check for any elements with red background that might be test elements
        const redElements = document.querySelectorAll('[style*="background: red"], [style*="background-color: red"]');
        redElements.forEach(el => {
            if (el.textContent && el.textContent.includes('TEST')) {
                console.log('Removing red test element:', el);
                el.remove();
            }
        });

        loadDropdownData();
    });

    async function loadDropdownData() {
        try {
            const response = await fetch('/Tickets/GetDropdownData');
            dropdownData = await response.json();
            populateDropdowns();
        } catch (error) {
            console.error('Error loading dropdown data:', error);
        }
    }

    function populateDropdowns() {
        // Populate clients dropdown
        const clientSelect = document.getElementById('demandeur');
        clientSelect.innerHTML = '<option value="">Sélectionner...</option>';
        dropdownData.clients.forEach(client => {
            const option = document.createElement('option');
            option.value = client.id;
            option.textContent = client.name;
            clientSelect.appendChild(option);
        });
    }

    function openModal() {
        console.log('Opening modal - Version 4.0 - ' + new Date().toISOString());

        // Ensure dropdown data is loaded first
        if (!dropdownData.clients || dropdownData.clients.length === 0) {
            console.log('Loading dropdown data first...');
            loadDropdownData().then(() => {
                openModalAfterDataLoad();
            });
        } else {
            openModalAfterDataLoad();
        }
    }

    function openModalAfterDataLoad() {
        const modal = document.getElementById('modalOverlay');
        const modalContent = document.getElementById('modalContent');

        if (!modal || !modalContent) {
            console.error('Modal elements not found!');
            return;
        }

        console.log('Modal found, making visible...');

        // Reset any previous styles that might interfere
        modal.style.cssText = '';
        modalContent.style.cssText = '';

        // Force display with explicit styles
