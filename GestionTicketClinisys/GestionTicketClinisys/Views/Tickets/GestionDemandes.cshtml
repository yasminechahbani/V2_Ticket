            }
        } catch (error) {
            console.error('Error bulk deleting tickets:', error);
            alert('Erreur lors de la suppression des tickets: ' + error.message);
        }
    }

    // Search and Filter functionality
    function applyFilters() {
        console.log('Applying filters...');

        const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
        const statusFilter = document.getElementById('statusFilter').value;
        const typeFilter = document.getElementById('typeFilter').value;
        const priorityFilter = document.getElementById('priorityFilter').value;
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo = document.getElementById('dateTo').value;

        const rows = document.querySelectorAll('#dataTable tbody tr');
        let visibleCount = 0;

        rows.forEach(row => {
            let showRow = true;

            // Get row data
            const cells = row.querySelectorAll('td');
            if (cells.length < 10) return; // Skip if not enough cells

            const titre = cells[1].textContent.toLowerCase().trim();
            const demandeur = cells[2].textContent.toLowerCase().trim();
            const date = cells[3].textContent.trim();
            const status = cells[4].textContent.trim();
            const priority = cells[5].textContent.trim();
            const type = cells[6].textContent.trim();
            const utilisateur = cells[7].textContent.toLowerCase().trim();
            const equipe = cells[8].textContent.toLowerCase().trim();
            const module = cells[9].textContent.toLowerCase().trim();

            // Apply search filter (search in multiple fields)
            if (searchTerm) {
                const searchableText = `${titre} ${demandeur} ${utilisateur} ${equipe} ${module}`;
                if (!searchableText.includes(searchTerm)) {
                    showRow = false;
                }
            }

            // Apply status filter
            if (statusFilter && status !== statusFilter) {
                showRow = false;
            }

            // Apply type filter
            if (typeFilter && type !== typeFilter) {
                showRow = false;
            }

            // Apply priority filter
            if (priorityFilter && priority !== priorityFilter) {
                showRow = false;
            }

            // Apply date range filter
            if (dateFrom || dateTo) {
                const rowDate = new Date(date);
                if (dateFrom && rowDate < new Date(dateFrom)) {
                    showRow = false;
                }
                if (dateTo && rowDate > new Date(dateTo)) {
                    showRow = false;
                }
            }

            // Show/hide row
            if (showRow) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
                // Uncheck hidden rows
                const checkbox = row.querySelector('.row-checkbox');
                if (checkbox) {
                    checkbox.checked = false;
                }
            }
        });

        // Update record count
        const totalCount = rows.length;
        document.getElementById('recordCount').textContent = `Total: ${totalCount} enregistrements (${visibleCount} affichés)`;

        // Update selection count
        updateSelectionCount();

        // Update header checkbox state
        updateHeaderCheckbox();

        console.log(`Filtered: ${visibleCount}/${totalCount} rows visible`);
    }

    function updateHeaderCheckbox() {
        const headerCheckbox = document.querySelector('thead input[type="checkbox"]');
        const visibleCheckboxes = document.querySelectorAll('.row-checkbox:not([style*="display: none"])');
        const checkedVisibleCheckboxes = document.querySelectorAll('.row-checkbox:not([style*="display: none"]):checked');

        if (visibleCheckboxes.length === 0) {
            headerCheckbox.indeterminate = false;
            headerCheckbox.checked = false;
        } else if (checkedVisibleCheckboxes.length === visibleCheckboxes.length) {
            headerCheckbox.indeterminate = false;
            headerCheckbox.checked = true;
        } else if (checkedVisibleCheckboxes.length > 0) {
            headerCheckbox.indeterminate = true;
            headerCheckbox.checked = false;
        } else {
            headerCheckbox.indeterminate = false;
            headerCheckbox.checked = false;
        }
    }

    function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('statusFilter').value = '';
        document.getElementById('typeFilter').value = '';
        document.getElementById('priorityFilter').value = '';
        document.getElementById('dateFrom').value = '';
        document.getElementById('dateTo').value = '';
        applyFilters();
    }
